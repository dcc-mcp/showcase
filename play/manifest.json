  "demos": [
    {
      "case_slug": "sonic-loom",
      "url": "play/sonic-loom/index.html",
      "title": "Sonic Loom",
      "engine": "Godot 4.6.3",
      "renderer": "gl_compatibility",
      "threads": false,
      "localeSupport": [
        "en",
        "zh"
      ],
      "nativeTextLanguage": "en",
      "controls": {
        "en": "Tap steps to edit. On phones, select a voice, then use Mute for that voice. Space: play/pause; arrows: tempo; S/L/R: save/load/reset. Native portrait controls scroll vertically.",
        "zh": "轻触步进编辑；手机先选择声部，再用 Mute 切换该声部静音。空格播放/暂停，上下键调速，S/L/R 保存、读取、重置。原生竖屏控件可上下滚动。"
      },
      "notes": {
        "en": "Audio starts after a click or tap. Saves stay in this browser. The native instrument artwork remains in English. Web adaptation/review, 2026-10-12: requested and accepted configuration gpt-6-astra / ultra; backend routing was not independently verified. Review covers desktop/phone screenshots and 40 browser checks. No subjective listening, physical-phone, Safari or Firefox acceptance.",
        "zh": "点击或轻触后启用声音，存档保留在当前浏览器，原生乐器画面保留英文。2026-10-12 Web 适配与复审请求并接受的配置为 gpt-6-astra / ultra；未独立核验后台路由。复审覆盖桌面与手机截图及40项浏览器检查，未作主观听评、实体手机、Safari 或 Firefox 验收。"
      }
    },
    {
      "case_slug": "prism-tide",
      "url": "play/prism-tide/index.html",
      "title": "Prism Tide",
      "engine": "Godot 4.6.3",
      "renderer": "gl_compatibility",
      "threads": false,
      "localeSupport": [
        "en",
        "zh"
      ],
      "nativeTextLanguage": "en",
      "controls": {
        "en": "On phones, tap a mirror or shutter to select it, then use Turn/Toggle below the scrolling board. Tab: select; Space/Enter: turn; R: reset; N: next after winning.",
        "zh": "手机先轻触镜子或闸门选中，再使用滚动棋盘下方的 Turn/Toggle 操作。Tab 选择，空格或回车转动，R 重置，过关后 N 下一关。"
      },
      "notes": {
        "en": "The original puzzle is silent. Explicit Save/Load stores a local checkpoint in this browser. Native puzzle artwork remains in English. Web adaptation/review, 2026-10-12: requested and accepted configuration gpt-6-astra / ultra; backend routing was not independently verified. Review covers desktop/phone screenshots and 40 browser checks. No subjective listening, physical-phone, Safari or Firefox acceptance.",
        "zh": "原作没有音轨。保存与读取按钮用于当前浏览器的本地关卡存档，原生谜题画面保留英文。2026-10-12 Web 适配与复审请求并接受的配置为 gpt-6-astra / ultra；未独立核验后台路由。复审覆盖桌面与手机截图及40项浏览器检查，未作主观听评、实体手机、Safari 或 Firefox 验收。"
      }
    },
    {
      "case_slug": "parcel-switchyard",
      "url": "play/parcel-switchyard/index.html",
      "title": "Parcel Switchyard",
      "engine": "Godot 4.6.3",
      "renderer": "gl_compatibility",
      "threads": false,
      "localeSupport": [
        "en",
        "zh"
      ],
      "nativeTextLanguage": "en-zh",
      "controls": {
        "en": "Match the next parcel label. Tap a route and Send. Keys 1/2/3 select; Space sends; A auto; P pause; R reset. Portrait controls scroll vertically.",
        "zh": "匹配下一件包裹标签，轻触线路再发送。1/2/3 选线，空格发送，A 自动，P 暂停，R 重置；竖屏操作区可上下滚动。"
      },
      "notes": {
        "en": "The original game is silent. Exit/reload starts a fresh shift. Web game labels and browser controls support English and Simplified Chinese; the original downloadable native package is unchanged. Export records and exact-head browser acceptance are separate; an export alone is not playability proof. No physical-device, Safari/Firefox or deployment claim.",
        "zh": "原作无音轨；退出或刷新即开始新班次，Web画面与浏览器控件支持中英文，原始原生下载包保持不变。导出记录与当前版本真实浏览器验收分开，导出成功不等于玩法通过；未声称实体设备、Safari、Firefox 或上线验证。"
      }
    },
    {
      "case_slug": "dawnkeep-defense",
      "url": "play/dawnkeep-defense/index.html",
      "title": "Dawnkeep / 曙光守誓",
      "engine": "Godot 4.6.3",
      "renderer": "gl_compatibility",
      "threads": false,
      "localeSupport": [
        "en",
        "zh"
      ],
      "nativeTextLanguage": "en-zh",
