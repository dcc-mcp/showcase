# Local render / capture scratch — never commit work-in-progress frames.
# Patterns are anchored with a leading "/" so they only match at the repository
# root. Unanchored patterns match at any depth and would silently ignore
# published artifacts such as media/<date>-<slug>/frame_0001.png.
/frame_*.png
/*.exr
/*.blend1
/*.blend2
/*.png.tmp
/*.swp
.DS_Store
Thumbs.db

# Site build output — produced by scripts/build_site.py, never committed.
/_site/
/_site-brand/
/_site-brand-preview/

# Python contract/build checks.
__pycache__/

# Local agent / IDE directories. These are runtime mount points, not source:
# an agent runtime materialises skills into them at task start, so a copy kept
# here is never the one that gets loaded and only drifts. Patterns are anchored
# with a leading "/" so only the repository root matches; unanchored patterns
# would silently ignore a nested directory of the same name.
/.agents/
/.agent_context/
/.aider/
/.augment/
/.beads/
/.claude/
/.cline/
/.clinerules/
/.codebuddy/
/.codegraph/
/.codex/
/.continue/
/.cursor/
/.gemini/
/.kimi/
/.kiro/
/.monica/
/.multica/
/.opencode/
/.roo/
/.serena/
/.trae/
/.windsurf/
