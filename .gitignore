# Local render / capture scratch — never commit work-in-progress frames.
# Patterns are anchored with a leading "/" so they only match at the repository
# root. Unanchored patterns match at any depth and would silently ignore
# published artifacts such as media/<date>-<slug>/frame_0001.png.
# "*.swp" is the deliberate exception: editor swap files are scratch at any
# depth and never a published artifact, so it stays unanchored.
/frame_*.png
/*.exr
/*.blend1
/*.blend2
/*.png.tmp
*.swp
.DS_Store
Thumbs.db

# Site build output — produced by scripts/build_site.py, never committed.
/_site/
/_site-brand/
/_site-brand-preview/

# Python contract/build checks.
__pycache__/

# Local agent / IDE directories. These are runtime mount points, not source:
# the skills and context that actually get loaded come from the Monica workspace
# skill registry, so keeping a copy in the repository only lets the two drift.
/.agents/
/.agent_context/
/.aider/
/.augment/
/.beads/
/.claude/
/.cline/
/.clinerules/
/.codebuddy/
/.codegraph/
/.codex/
/.continue/
/.cursor/
/.gemini/
/.kimi/
/.kiro/
/.monica/
/.multica/
/.opencode/
/.roo/
/.serena/
/.trae/
/.windsurf/
