config_version=5
[application]
config/name="Dawnkeep — Oath of the Last Light"
run/main_scene="res://start.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="disabled"
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
textures/default_filters/anisotropic_filtering_level=2
environment/defaults/default_clear_color=Color(0.035,0.075,0.09,1)
[physics]
3d/physics_engine="Jolt Physics"
2d/physics_engine="Dummy"
common/physics_ticks_per_second=60
[input_devices]
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false
[audio]
driver/mix_rate=44100
