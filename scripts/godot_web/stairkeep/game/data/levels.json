{
  "schema_version": 1,
  "title": "阶塔",
  "title_note": "临时名，可改名。English working title: Stairkeep.",
  "rules": {
    "turn_order": "hero_first",
    "player_damage": "max(0, player.atk - enemy.def)",
    "enemy_damage": "max(0, enemy.atk - player.def)",
    "rounds": "ceil(enemy.hp / player_damage)",
    "damage": "max(0, rounds - 1) * enemy_damage",
    "win_condition": "player_damage > 0 and player.hp > damage",
    "key_consumption": "one key on first successful open, opened doors persist",
    "health_cap": null,
    "movement": "4-neighbor logical grid; isometric presentation; no diagonal moves",
    "object_collision": "enemy and locked door stop movement until successful interaction; stairs explicitly transfer to target position",
    "save_schema_version": 1
  },
